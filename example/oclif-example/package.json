{
  "name": "oclif-example",
  "version": "0.0.0",
  "author": "Nathaniel Camomot",
  "type": "module",
  "bin": {
    "oclif-example": "./bin/run.js"
  },
  "bugs": "https://github.com/natzcam/oclif-example/issues",
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "conf": "^15.1.0",
    "conf-cli": "file:../.."
  },
  "devDependencies": {
    "oclif": "^4.24.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin/run.js",
    "/bin/run.cmd",
    "/oclif.manifest.json",
    "/src"
  ],
  "homepage": "https://github.com/natzcam/oclif-example",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "oclif": {
    "commands": "./src/commands",
    "bin": "oclif-example",
    "plugins": [
      "@oclif/plugin-help",
      "conf-cli"
    ]
  },
  "repository": "natzcam/oclif-example",
  "scripts": {
    "prepack": "oclif manifest && oclif readme",
    "postpack": "rm -f oclif.manifest.json",
    "version": "oclif readme && git add README.md"
  }
}
