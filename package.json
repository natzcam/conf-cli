{
  "name": "conf-cli",
  "description": "simple cli for configuration and key/value's",
  "version": "1.0.0",
  "author": "Nathaniel Camomot",
  "type": "module",
  "bin": {
    "conf": "./bin/run.js"
  },
  "bugs": "https://github.com/natzcam/conf-cli/issues",
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "conf": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@oclif/test": "^4.2.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "oclif": "^4.24.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": "./lib/index.js",
  "files": [
    "/bin/run.js",
    "/bin/run.cmd",
    "/lib",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/natzcam/conf-cli",
  "keywords": [
    "oclif",
    "conf",
    "cli",
    "config"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "oclif": {
    "bin": "conf",
    "commands": "./lib/commands",
    "helpClass": "./lib/help.js",
    "topicSeparator": " "
  },
  "repository": "natzcam/conf-cli",
  "scripts": {
    "build": "rimraf lib && tsc",
    "lint": "eslint .",
    "test": "tsc -p test && c8 --include src mocha && eslint .",
    "prepack": "npm run build && oclif manifest",
    "postpack": "rimraf oclif.manifest.json"
  }
}
